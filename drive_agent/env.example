# All secret/key files must have mode 600. Do not commit their contents.
SKYSEAL_GOOGLE_SERVICE_ACCOUNT=/etc/skyseal-agent/google-service-account.json
SKYSEAL_DRIVE_FOLDER_ID=replace-with-private-inbox-folder-id

SKYSEAL_AGENT_SERVER=https://proof.excyberlab.net
SKYSEAL_AGENT_RP_ID=proof.excyberlab.net
SKYSEAL_AGENT_TOKEN_FILE=/etc/skyseal-agent/drive-agent.token

SKYSEAL_GITHUB_OWNER=kagaya
SKYSEAL_GITHUB_REPOSITORY=SkySeal
SKYSEAL_GITHUB_TOKEN_FILE=/etc/skyseal-agent/github.token
SKYSEAL_GITHUB_BRANCH=main
SKYSEAL_GITHUB_PREFIX=evidence

SKYSEAL_AGENT_DATABASE=/var/lib/skyseal-agent/drive-agent.sqlite3
SKYSEAL_AGENT_WORK=/var/lib/skyseal-agent/work
SKYSEAL_DRIVE_SETTLE_SECONDS=120
SKYSEAL_DRIVE_POLL_SECONDS=30
