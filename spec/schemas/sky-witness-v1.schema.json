{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skyseal:schema:sky-witness:v1",
  "title": "SkySeal JMA Himawari sky witness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider",
    "platform",
    "product",
    "observation_time",
    "retrieved_at",
    "source_url",
    "media_type",
    "image_digest",
    "attribution"
  ],
  "properties": {
    "schema": {"const": "urn:skyseal:sky-witness:v1"},
    "provider": {"const": "Japan Meteorological Agency (JMA)"},
    "platform": {"const": "Himawari-8/9"},
    "product": {"const": "Full Disk Band 13 infrared"},
    "observation_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9][0-9]:00Z$"
    },
    "retrieved_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://www\\.data\\.jma\\.go\\.jp/mscweb/data/himawari/img/fd_/fd__b13_[0-9]{4}\\.jpg$"
    },
    "media_type": {"const": "image/jpeg"},
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "attribution": {"const": "Japan Meteorological Agency (JMA)"}
  }
}
