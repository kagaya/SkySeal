{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skyseal:schema:seal-payload:v1",
  "title": "SkySeal v1 seal payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "seal_id",
    "commitment_format",
    "subject_digest",
    "identity_id",
    "identity_version",
    "identity_state_digest",
    "nonce",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "urn:skyseal:seal-payload:v1"
    },
    "seal_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "commitment_format": {
      "const": "skyseal-sha256-set-v1"
    },
    "subject_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "identity_id": {
      "type": "string",
      "pattern": "^https://orcid\\.org/[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"
    },
    "identity_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "identity_state_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "private_ledger_commitment": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
