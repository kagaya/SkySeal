{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skyseal:schema:publication-manifest:v1",
  "title": "SkySeal v1 publication manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "seal_id", "artifacts", "timestamp_targets"],
  "properties": {
    "schema": {"const": "urn:skyseal:publication-manifest:v1"},
    "seal_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "artifacts": {
      "type": "object",
      "minProperties": 6,
      "maxProperties": 6,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256"],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "timestamp_targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proof", "target"],
        "properties": {
          "proof": {"type": "string"},
          "target": {"type": "string"}
        }
      }
    }
  }
}

