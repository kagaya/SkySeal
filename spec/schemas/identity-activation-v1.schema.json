{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skyseal:schema:identity-activation:v1",
  "title": "SkySeal ORCID-bound Passkey identity activation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "activation_payload", "webauthn", "verification"],
  "properties": {
    "schema": {"const": "urn:skyseal:identity-activation:v1"},
    "activation_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "identity_id",
        "identity_version",
        "identity_genesis_digest",
        "rp_id",
        "nonce",
        "created_at"
      ],
      "properties": {
        "schema": {"const": "urn:skyseal:identity-activation-payload:v1"},
        "identity_id": {
          "type": "string",
          "pattern": "^https://orcid\\.org/[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"
        },
        "identity_version": {"const": 1},
        "identity_genesis_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rp_id": {"type": "string", "minLength": 1, "maxLength": 253},
        "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "webauthn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_data_json", "authenticator_data", "signature"],
      "properties": {
        "client_data_json": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "authenticator_data": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rp_id", "allowed_origin"],
      "properties": {
        "rp_id": {"type": "string", "minLength": 1, "maxLength": 253},
        "allowed_origin": {"type": "string", "format": "uri"}
      }
    }
  }
}
