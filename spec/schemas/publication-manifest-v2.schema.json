{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skyseal:schema:publication-manifest:v2",
  "title": "SkySeal v1.2 publication manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "seal_id", "artifacts", "timestamp_targets"],
  "properties": {
    "schema": {"const": "urn:skyseal:publication-manifest:v2"},
    "seal_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hashes.txt",
        "seal.skyseal.json",
        "seal.skyseal.json.ots",
        "identity-genesis.json",
        "identity-activation.json",
        "identity-activation.json.ots"
      ],
      "properties": {
        "hashes.txt": {"$ref": "#/$defs/artifact"},
        "seal.skyseal.json": {"$ref": "#/$defs/artifact"},
        "seal.skyseal.json.ots": {"$ref": "#/$defs/artifact"},
        "identity-genesis.json": {"$ref": "#/$defs/artifact"},
        "identity-activation.json": {"$ref": "#/$defs/artifact"},
        "identity-activation.json.ots": {"$ref": "#/$defs/artifact"},
        "sky-witness.json": {"$ref": "#/$defs/artifact"},
        "sky-witness.jpg": {"$ref": "#/$defs/artifact"}
      },
      "dependentRequired": {
        "sky-witness.json": ["sky-witness.jpg"],
        "sky-witness.jpg": ["sky-witness.json"]
      }
    },
    "timestamp_targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proof", "target"],
        "properties": {
          "proof": {"type": "string"},
          "target": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
