#!/usr/bin/env bash
# SkySeal one-command sealing workflow.
#
# Usage:
#   bash skyseal seal [--uid UID_OR_FINGERPRINT] [--output-dir DIR] [--publish] [--force] TARGET_DIR
#
# The public hash list contains SHA-256 digests only. Source paths and file
# names are deliberately not written to the public artifacts.

set -euo pipefail
IFS=$'\n\t'

PROGRAM="${0##*/}"

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

info() {
  printf 'INFO: %s\n' "$*" >&2
}

usage() {
  cat <<EOF
Usage:
  bash ${PROGRAM} seal [options] TARGET_DIR

Options:
  --uid UID_OR_FINGERPRINT  GPG signing key. If omitted, use
                            SKYSEAL_GPG_UID or the only available secret key.
  --output-dir DIR          Write public artifacts here (default: current dir).
  --publish                 Commit and push only the generated public artifacts.
                            The script must be inside a local kagaya/SkySeal clone.
  --remote NAME             Git remote used by --publish (default: origin).
  --force                   Back up colliding outputs and continue.
  --no-ots                  Explicitly skip OpenTimestamps sealing.
  -h, --help                Show this help.

Created artifacts:
  YYYYMMDD_HHMM_public.txt
  YYYYMMDD_HHMM_public.txt.asc
  YYYYMMDD_HHMM_public.txt.asc.ots   (unless --no-ots)

The target files themselves are not copied and their names are not published.
EOF
}

script_directory() {
  cd "$(dirname "$0")" && pwd
}

hash_command() {
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s\n' sha256sum
  elif command -v shasum >/dev/null 2>&1; then
    printf '%s\n' 'shasum -a 256'
  else
    die "Neither 'sha256sum' nor 'shasum' is available."
  fi
}

resolve_uid() {
  local requested="${1:-}"
  local fingerprints count

  if [[ -n "$requested" ]]; then
    printf '%s\n' "$requested"
    return
  fi

  if [[ -n "${SKYSEAL_GPG_UID:-}" ]]; then
    printf '%s\n' "$SKYSEAL_GPG_UID"
    return
  fi

  fingerprints="$(
    gpg --batch --with-colons --list-secret-keys 2>/dev/null |
      awk -F: '
        $1 == "sec" { want_fpr = 1; next }
        want_fpr && $1 == "fpr" { print $10; want_fpr = 0 }
      '
  )"
  count="$(printf '%s\n' "$fingerprints" | awk 'NF { n++ } END { print n + 0 }')"

  case "$count" in
    1) printf '%s\n' "$fingerprints" ;;
    0) die "No GPG secret key found. Supply --uid or import/create a key." ;;
    *) die "Multiple GPG secret keys found. Supply --uid or set SKYSEAL_GPG_UID." ;;
  esac
}

backup_if_needed() {
  local path="$1"
  local force="$2"
  local backup_stamp

  [[ -e "$path" ]] || return 0
  [[ "$force" -eq 1 ]] || die "Output already exists: $path (use --force to back it up)"
  backup_stamp="$(date -u '+%Y%m%dT%H%M%SZ')"
  mv -- "$path" "${path}.bak.${backup_stamp}"
}

make_hashlist() {
  local target_dir="$1"
  local output_file="$2"
  local hash_spec="$3"
  local temporary_file found file hash
  local -a hash_argv

  read -r -a hash_argv <<<"$hash_spec"
  temporary_file="$(mktemp "${TMPDIR:-/tmp}/skyseal-hashes.XXXXXX")"
  found=0

  while IFS= read -r -d '' file; do
    found=1
    hash="$("${hash_argv[@]}" "$file" | awk '{print $1}')"
    [[ "$hash" =~ ^[0-9A-Fa-f]{64}$ ]] || {
      rm -f -- "$temporary_file"
      die "Invalid SHA-256 output while hashing a target file."
    }
    printf '%s\n' "$hash" >>"$temporary_file"
  done < <(find "$target_dir" -type f -print0)

  if [[ "$found" -eq 0 ]]; then
    rm -f -- "$temporary_file"
    die "No files found under target directory: $target_dir"
  fi

  # Sorting the digest-only list makes repeated runs reproducible without
  # publishing the private source paths used to establish the order.
  LC_ALL=C sort "$temporary_file" >"$output_file"
  rm -f -- "$temporary_file"
}

publish_artifacts() {
  local repo_root="$1"
  local remote="$2"
  local timestamp="$3"
  shift 3
  local branch remote_url normalized_url path
  local -a paths

  paths=("$@")
  [[ ${#paths[@]} -gt 0 ]] || die "No public artifacts were supplied for publishing."

  remote_url="$(git -C "$repo_root" remote get-url "$remote" 2>/dev/null)" ||
    die "Git remote not found: $remote"
  normalized_url="$(printf '%s' "$remote_url" | tr '[:upper:]' '[:lower:]')"
  case "$normalized_url" in
    https://github.com/kagaya/skyseal|https://github.com/kagaya/skyseal.git|git@github.com:kagaya/skyseal.git|ssh://git@github.com/kagaya/skyseal.git)
      ;;
    *)
      die "Refusing to publish to unexpected remote: $remote_url"
      ;;
  esac

  branch="$(git -C "$repo_root" symbolic-ref --quiet --short HEAD 2>/dev/null)" ||
    die "Cannot publish from a detached Git HEAD. Check out a branch first."
  [[ -n "$branch" ]] || die "Could not determine the current Git branch."

  if [[ -n "$(git -C "$repo_root" diff --name-only --diff-filter=U)" ]]; then
    die "The repository has unresolved merge conflicts. Resolve them before publishing."
  fi

  # Paths are basenames in the repository root. No source target path is ever
  # passed to Git, and unrelated staged or working-tree changes are excluded.
  for path in "${paths[@]}"; do
    [[ "$path" != */* ]] || die "Unsafe publish path: $path"
    [[ -f "${repo_root}/${path}" ]] || die "Generated artifact not found: ${repo_root}/${path}"
  done

  info "Staging only the generated SkySeal artifacts"
  git -C "$repo_root" add -- "${paths[@]}"
  git -C "$repo_root" commit --only -m "Add SkySeal record ${timestamp}" -- "${paths[@]}"

  info "Pushing commit to ${remote}/${branch}"
  if ! git -C "$repo_root" push "$remote" "$branch"; then
    die "Git push failed. The commit remains safely in the local repository; update the branch and retry the push."
  fi

  printf '  Published  : %s (%s)\n' "$remote_url" "$branch"
}

seal() {
  local uid=""
  local output_dir="."
  local force=0
  local use_ots=1
  local publish=0
  local remote="origin"
  local output_dir_given=0
  local target_dir=""
  local timestamp base hashlist signature ots_file pubkey fingerprint
  local hash_spec repo_root script_dir pubkey_created
  local -a publish_paths

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --uid)
        shift
        [[ $# -gt 0 ]] || die "--uid requires a value."
        uid="$1"
        shift
        ;;
      --output-dir)
        shift
        [[ $# -gt 0 ]] || die "--output-dir requires a value."
        output_dir="$1"
        output_dir_given=1
        shift
        ;;
      --publish)
        publish=1
        shift
        ;;
      --remote)
        shift
        [[ $# -gt 0 ]] || die "--remote requires a value."
        remote="$1"
        shift
        ;;
      --force|-f)
        force=1
        shift
        ;;
      --no-ots)
        use_ots=0
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      -*) die "Unknown option: $1" ;;
      *)
        [[ -z "$target_dir" ]] || die "Only one TARGET_DIR may be supplied."
        target_dir="$1"
        shift
        ;;
    esac
  done

  [[ -n "$target_dir" ]] || die "TARGET_DIR is required."
  [[ -d "$target_dir" ]] || die "Target directory not found: $target_dir"

  repo_root=""
  if [[ "$publish" -eq 1 ]]; then
    [[ "$use_ots" -eq 1 ]] || die "--publish cannot be combined with --no-ots."
    command -v git >/dev/null 2>&1 || die "git not found in PATH."
    script_dir="$(script_directory)"
    repo_root="$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null)" ||
      die "--publish requires skyseal to be run from a local Git clone."
    if [[ "$output_dir_given" -eq 0 ]]; then
      output_dir="$repo_root"
    fi
  fi

  mkdir -p -- "$output_dir"
  output_dir="$(cd "$output_dir" && pwd)"
  if [[ "$publish" -eq 1 && "$output_dir" != "$repo_root" ]]; then
    die "--publish writes records to the repository root; omit --output-dir or set it to: $repo_root"
  fi

  command -v gpg >/dev/null 2>&1 || die "gpg not found in PATH."
  if [[ "$use_ots" -eq 1 ]]; then
    command -v ots >/dev/null 2>&1 || die "ots not found in PATH. Install the OpenTimestamps client or explicitly use --no-ots."
  fi

  hash_spec="$(hash_command)"
  uid="$(resolve_uid "$uid")"
  gpg --batch --list-secret-keys "$uid" >/dev/null 2>&1 || die "GPG secret key not found for: $uid"

  timestamp="$(date '+%Y%m%d_%H%M')"
  base="${timestamp}_public.txt"
  hashlist="${output_dir}/${base}"
  signature="${hashlist}.asc"
  ots_file="${signature}.ots"

  backup_if_needed "$hashlist" "$force"
  backup_if_needed "$signature" "$force"
  [[ "$use_ots" -eq 0 ]] || backup_if_needed "$ots_file" "$force"

  info "Hashing files without publishing their names"
  make_hashlist "$target_dir" "$hashlist" "$hash_spec"

  info "Signing ${base}"
  # Do not use --batch here: an encrypted secret key may need pinentry.
  gpg --armor --detach-sign --local-user "$uid" --output "$signature" -- "$hashlist"
  [[ -f "$signature" ]] || die "GPG did not create the expected signature: $signature"

  if [[ "$use_ots" -eq 1 ]]; then
    info "Creating OpenTimestamps proof"
    (
      cd "$output_dir"
      ots stamp -- "${base}.asc"
    )
    [[ -f "$ots_file" ]] || die "OpenTimestamps did not create the expected proof: $ots_file"
  fi

  fingerprint="$(gpg --batch --with-colons --fingerprint "$uid" | awk -F: '$1 == "fpr" { print $10; exit }')"
  [[ -n "$fingerprint" ]] || die "Could not resolve the signing-key fingerprint."
  pubkey="${output_dir}/publickey_${fingerprint}.asc"
  pubkey_created=0
  if [[ ! -e "$pubkey" ]]; then
    info "Exporting public key"
    gpg --batch --armor --export "$fingerprint" >"$pubkey"
    pubkey_created=1
  fi

  printf '\nSkySeal completed.\n'
  printf '  Hash list : %s\n' "$hashlist"
  printf '  Signature : %s\n' "$signature"
  if [[ "$use_ots" -eq 1 ]]; then
    printf '  Timestamp : %s\n' "$ots_file"
  else
    printf '  Timestamp : skipped by explicit --no-ots\n'
  fi
  printf '  GPG key   : %s\n' "$fingerprint"

  if [[ "$publish" -eq 1 ]]; then
    publish_paths=("$base" "${base}.asc" "${base}.asc.ots")
    if [[ "$pubkey_created" -eq 1 ]]; then
      publish_paths+=("$(basename "$pubkey")")
    fi
    publish_artifacts "$repo_root" "$remote" "$timestamp" "${publish_paths[@]}"
  fi
}

case "${1:-}" in
  seal)
    shift
    seal "$@"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    die "Unknown command: $1 (expected: seal)"
    ;;
esac
