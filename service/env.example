# Production requires an HTTPS reverse proxy and exact registered ORCID redirect URI.
SKYSEAL_ORIGIN=https://proof.excyberlab.net
SKYSEAL_RP_ID=proof.excyberlab.net
SKYSEAL_HOST=127.0.0.1
SKYSEAL_PORT=8787
SKYSEAL_DATABASE=/var/lib/skyseal/skyseal.sqlite3
SKYSEAL_PUBLIC_ROOT=/var/lib/skyseal-public
# Pending approval remains available for one day. Expired Drive jobs are
# recreated by the agent from the verified cached hash list.
SKYSEAL_TRANSACTION_LIFETIME_SECONDS=86400

SKYSEAL_ORCID_BASE_URL=https://orcid.org
SKYSEAL_ORCID_CLIENT_ID=APP-REPLACE-ME
SKYSEAL_ORCID_CLIENT_SECRET=REPLACE-ME
SKYSEAL_ORCID_REDIRECT_URI=https://proof.excyberlab.net/api/v1/orcid/callback

SKYSEAL_OPENPGP_FINGERPRINT=85F79058BD83EB3889DEF766B065C54586067E2E

# Development only; never enable on a public bind address.
# SKYSEAL_DEV_ALLOW_HTTP_LOCALHOST=1
# SKYSEAL_DEV_MOCK_ORCID=1
# SKYSEAL_DEV_ALLOW_UNSEALED_IDENTITY=1
