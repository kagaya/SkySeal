[Unit]
Description=Upgrade pending SkySeal OpenTimestamps proofs
Documentation=https://github.com/kagaya/SkySeal
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=skyseal-agent
Group=skyseal-agent
WorkingDirectory=/opt/skyseal
EnvironmentFile=/etc/skyseal-agent/agent.env
Environment=PATH=/opt/skyseal/.venv-agent/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=XDG_CACHE_HOME=/var/lib/skyseal-agent/cache
StateDirectory=skyseal-agent
StateDirectoryMode=0700
UMask=0077
LimitCORE=0
MemorySwapMax=0
ExecStartPre=/opt/skyseal/.venv-agent/bin/python /opt/skyseal/deploy/check_config.py agent
ExecStart=/usr/bin/flock --wait 600 /var/lib/skyseal-agent/drive-agent.lock /opt/skyseal/.venv-agent/bin/python /opt/skyseal/drive_agent/agent.py upgrade

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/skyseal-agent
